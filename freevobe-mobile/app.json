{
  "expo": {
    "name": "Freevobe Mobile",
    "slug": "freevobe-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "freevobe",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050505",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "dev.freevobe.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Freevobe använder kameran för att läsa QR-koden som Freevobe Desktop visar när du parar ihop telefonen med din dator. Ingen bild spelas in eller skickas vidare.",
        "NSLocalNetworkUsageDescription": "Freevobe Mobile talar med Freevobe Desktop på din dator i samma lokala nätverk. Ingen trafik går till internet."
      }
    },
    "android": {
      "package": "dev.freevobe.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#050505",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["CAMERA"]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050505",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": { "backgroundColor": "#050505" }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Freevobe använder kameran för att läsa QR-koden från Freevobe Desktop vid parning."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#8b5cf6",
          "defaultChannel": "freevobe-status"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
