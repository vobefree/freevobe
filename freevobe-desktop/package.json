{
  "name": "freevobe",
  "version": "0.2.4",
  "private": true,
  "description": "Freevobe – lokal-first vibecoding desktop app med Ollama, agent-loop, skills, MCP och subagents.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,desktop -c cyan,magenta \"npm:dev:server\" \"npm:dev:desktop\"",
    "dev:server": "npm run dev --workspace @freevobe/agent-server",
    "dev:desktop": "npm run dev --workspace @freevobe/desktop",
    "dev:web": "npm run dev --workspace @freevobe/web",
    "build": "npm run build --workspaces --if-present",
    "build:desktop": "npm run build --workspace @freevobe/desktop",
    "build:web": "npm run build --workspace @freevobe/web",
    "tauri": "npm run tauri --workspace @freevobe/desktop --",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doctor": "node packages/agent-core/bin/freevobe-doctor.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "sidecar:build": "npm run build --workspace @freevobe/agent-server && node scripts/build-sidecar.mjs",
    "verify": "npm run typecheck && npm run lint && npm run i18n:check && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "esbuild": "0.28.2",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "postject": "1.0.0-alpha.6",
    "prettier": "^3.4.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.30.0",
    "vitest": "^3.2.0"
  }
}
