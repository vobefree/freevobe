{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Freevobe",
  "mainBinaryName": "Freevobe",
  "version": "0.2.5",
  "identifier": "dev.freevobe.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Freevobe",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "theme": "Dark",
        "decorations": true,
        "backgroundColor": "#14161c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:4319 http://localhost:4319 ws://127.0.0.1:4319; worker-src 'self' blob:",
      "dangerousDisableAssetCspModification": false,
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "tooltip": "Freevobe"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Lokal-first vibecoding med Ollama",
    "longDescription": "Freevobe är en lokal-first AI-coding agent för skrivbordet. Anslut Ollama, välj modell och bygg mjukvara i naturligt språk – koden lämnar aldrig datorn om du inte själv aktiverar en molntjänst.",
    "copyright": "© 2026 Freevobe",
    "publisher": "Freevobe",
    "resources": ["builtin-skills/*"],
    "externalBin": ["binaries/freevobe-agent"],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["Swedish", "English"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 }
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": ["https://releases.freevobe.dev/{{target}}/{{arch}}/{{current_version}}"],
      "pubkey": "TAURI-UPDATER-PUBKEY-PLACEHOLDER-Se README (signering ar inte konfigurerad an)",
      "windows": {
        "installMode": "passive"
      }
    },
    "shell": {
      "open": false
    }
  }
}
