{
  "name": "@freevobe/agent-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lokal Freevobe-agent över HTTP+SSE på 127.0.0.1. Startas av skrivbordsappen (Tauri-sidecar) eller manuellt.",
  "bin": {
    "freevobe-agent": "./bin/freevobe-agent.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./hub": "./src/sessionHub.ts"
  },
  "scripts": {
    "dev": "node --import ../../scripts/register-ts.mjs src/index.ts",
    "start": "node bin/freevobe-agent.mjs",
    "build": "node ../../scripts/build-agent.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@freevobe/agent-core": "*",
    "@freevobe/protocol": "*"
  },
  "optionalDependencies": {
    "playwright": "^1.50.0"
  }
}
