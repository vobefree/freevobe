# Publik basadress till appen (krävs för Shopify OAuth)
APP_URL=http://localhost:3100


# Shopify-app (Shopify Partners → App setup)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_themes,write_themes,read_reports
SHOPIFY_API_VERSION=2026-07

# Social inloggning (valfritt – knapparna visas alltid men kräver nycklar)
# Google: redirect URI {APP_URL}/api/auth/social/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook: redirect URI {APP_URL}/api/auth/social/facebook/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Stripe (valfritt – utan nycklar körs betalningar i dev-läge)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AI – endast gratistjanster. Utan nyckel svarar de nyckelfria vagarna.
# Bygg med AI provar i denna ordning: Kilo Gateway (nyckelfri gratismodell)
# -> Pollinations (nyckelfri, 1 svar/30 s) -> Gemini gratisniva -> OpenRouter free.
# Satt FREE_AI_KEYLESS=0 for att hoppa over de tva nyckelfria vagarna.
FREE_AI_KEYLESS=1
KILO_MODEL=minimax/minimax-m3.1-flash:free

# OpenRouter (valfri, provas sist). Modellen tvingas till openrouter/free.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Google Gemini (valfri, gratisniva) - provas efter de nyckelfria vagarna.
# Skapa nyckel pa https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

PAGESPEED_API_KEY=

# Adminpanel: kommaseparerade e-postadresser som far oppna /admin
ADMIN_EMAILS=

# Endast for test/proxy: peka Gemini-klienten mot annan bas-URL
# GEMINI_API_BASE=http://127.0.0.1:4599
