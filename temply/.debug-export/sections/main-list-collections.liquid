<section class="section">
  <div class="container">
    <div class="page-head"><h1>Kollektioner</h1></div>
    <div class="features">
      {%- for collection in collections -%}
        <a class="feature" href="{{ collection.url }}">
          <h3>{{ collection.title }}</h3>
          <p>{{ collection.products_count }} produkter</p>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collections",
  "settings": []
}
{% endschema %}
