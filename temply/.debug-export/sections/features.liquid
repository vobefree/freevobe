<section class="section" data-reveal style="--features: {{ section.blocks.size | at_least: 1 }}">
  <div class="container">
    <div class="section-head{% if section.settings.align == 'center' %} section-head--center{% endif %}">
      {%- if section.settings.title != blank -%}<h2>{{ section.settings.title }}</h2>{%- endif -%}
      {%- if section.settings.subtitle != blank -%}<p>{{ section.settings.subtitle }}</p>{%- endif -%}
    </div>
    <div class="features">
      {%- for block in section.blocks -%}
        <div class="feature" {{ block.shopify_attributes }}>
          <span class="feature__icon" aria-hidden="true">{% render 'icon', name: block.settings.icon, size: 22 %}</span>
          <h3>{{ block.settings.title | escape }}</h3>
          <p>{{ block.settings.text | escape }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Features",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": ""
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": ""
    },
    {
      "type": "select",
      "id": "align",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "sparkles",
          "options": [
            {
              "value": "search",
              "label": "Search"
            },
            {
              "value": "cart",
              "label": "Shopping bag"
            },
            {
              "value": "truck",
              "label": "Fast shipping"
            },
            {
              "value": "shield",
              "label": "Secure purchase"
            },
            {
              "value": "heart",
              "label": "Handmade"
            },
            {
              "value": "star",
              "label": "Rating"
            },
            {
              "value": "leaf",
              "label": "Natural"
            },
            {
              "value": "sparkles",
              "label": "Highlights"
            },
            {
              "value": "check",
              "label": "Included"
            },
            {
              "value": "mail",
              "label": "Newsletter"
            },
            {
              "value": "plus",
              "label": "Add"
            },
            {
              "value": "minus",
              "label": "Remove"
            }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": ""
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Features"
    }
  ]
}
{% endschema %}
