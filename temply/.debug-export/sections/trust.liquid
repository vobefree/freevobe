<section class="section section--trust">
  <div class="container">
    {%- if section.settings.title != blank -%}<h2 class="visually-hidden">{{ section.settings.title }}</h2>{%- endif -%}
    <div class="trust-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'badge' -%}
          <div class="trust" {{ block.shopify_attributes }}>
            <span class="trust__icon" aria-hidden="true">{% render 'icon', name: block.settings.icon, size: 22 %}</span>
            <b>{{ block.settings.title }}</b>
            <small>{{ block.settings.text }}</small>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if section.settings.shipping != blank or section.settings.returns != blank -%}
      <p class="trust__meta">{{ section.settings.shipping }} · {{ section.settings.returns }}</p>
    {%- endif -%}
    {%- for block in section.blocks -%}
  {%- if block.type == '@app' -%}<div class="app-block" {{ block.shopify_attributes }}>{% render block %}</div>{%- endif -%}
{%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Trust badges",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Tryggt att handla"
    },
    {
      "type": "text",
      "id": "shipping",
      "label": "Shipping info",
      "default": ""
    },
    {
      "type": "text",
      "id": "returns",
      "label": "Returns info",
      "default": ""
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "shield",
          "options": [
            {
              "value": "search",
              "label": "Search"
            },
            {
              "value": "cart",
              "label": "Shopping bag"
            },
            {
              "value": "truck",
              "label": "Fast shipping"
            },
            {
              "value": "shield",
              "label": "Secure purchase"
            },
            {
              "value": "heart",
              "label": "Handmade"
            },
            {
              "value": "star",
              "label": "Rating"
            },
            {
              "value": "leaf",
              "label": "Natural"
            },
            {
              "value": "sparkles",
              "label": "Highlights"
            },
            {
              "value": "check",
              "label": "Included"
            },
            {
              "value": "mail",
              "label": "Newsletter"
            },
            {
              "value": "plus",
              "label": "Add"
            },
            {
              "value": "minus",
              "label": "Remove"
            }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": ""
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": ""
        }
      ]
    },
    {
      "type": "@app",
      "name": "App"
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Trust badges"
    }
  ]
}
{% endschema %}
