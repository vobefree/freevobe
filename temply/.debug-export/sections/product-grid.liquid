{%- assign grid_collection = collections[section.settings.collection] -%}
{%- if grid_collection == blank -%}{%- assign grid_collection = collections.all -%}{%- endif -%}
<section class="section columns-{{ section.settings.columns }} ratio-{{ section.settings.ratio }} gap-{{ section.settings.gap }} span-{{ section.settings.span }} variant-{{ section.settings.variant }}" data-reveal>
  <div class="container">
    <div class="section-head{% if section.settings.align == 'center' %} section-head--center{% endif %}">
      {%- if section.settings.title != blank -%}<h2>{{ section.settings.title }}</h2>{%- endif -%}
      {%- if section.settings.subtitle != blank -%}<p>{{ section.settings.subtitle }}</p>{%- endif -%}
    </div>
    <div class="product-grid product-grid--{{ section.settings.style }}">
      {%- if grid_collection.products.size > 0 -%}
        {%- for product in grid_collection.products limit: section.settings.limit -%}
          {% render 'product-card', product: product, show_price: section.settings.show_price, show_rating: section.settings.show_rating, badge: section.settings.badge %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.columns) -%}
          <article class="card">
            <div class="card__media"><div class="card__placeholder"></div></div>
            <div class="card__info"><h3 class="card__title">Your product</h3><p class="card__price">Add products in Shopify</p></div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
    {%- if section.settings.cta_label != blank -%}
      <div class="section-foot"><a class="btn btn--ghost" href="{{ grid_collection.url }}">{{ section.settings.cta_label | escape }}</a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product grid",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Utvalt just nu"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": ""
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Card style",
      "default": "rounded",
      "options": [
        {
          "value": "minimal",
          "label": "Minimal"
        },
        {
          "value": "rounded",
          "label": "Rounded"
        },
        {
          "value": "cards",
          "label": "Cards"
        }
      ]
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "unit": "",
      "default": 3
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products shown",
      "min": 2,
      "max": 12,
      "step": 1,
      "unit": "",
      "default": 8
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image ratio",
      "default": "portrait",
      "options": [
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Inner spacing",
      "min": 50,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "span",
      "label": "Asymmetry",
      "default": "even",
      "options": [
        {
          "value": "even",
          "label": "Even"
        },
        {
          "value": "feature",
          "label": "Featured"
        },
        {
          "value": "mosaic",
          "label": "Mosaic"
        }
      ]
    },
    {
      "type": "select",
      "id": "variant",
      "label": "Variant",
      "default": "grid",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "dense",
          "label": "Dense"
        },
        {
          "value": "deal",
          "label": "Deal"
        },
        {
          "value": "showcase",
          "label": "Showcase"
        },
        {
          "value": "editorial",
          "label": "Editorial"
        },
        {
          "value": "spec",
          "label": "Spec"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating",
      "default": true
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Product badge",
      "default": ""
    },
    {
      "type": "select",
      "id": "align",
      "label": "Heading alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": ""
    }
  ],
  "presets": [
    {
      "name": "Product grid"
    }
  ]
}
{% endschema %}
