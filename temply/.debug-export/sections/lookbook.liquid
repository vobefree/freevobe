<section class="section lookbook-wrap" data-reveal>
  <div class="container">
    <div class="section-head">
      <h2>{{ section.settings.title }}</h2>
      {%- if section.settings.subtitle != blank -%}<p>{{ section.settings.subtitle }}</p>{%- endif -%}
    </div>
    <div class="lookbook columns-{{ section.settings.columns }} ratio-{{ section.settings.ratio }} gap-{{ section.settings.gap }} span-{{ section.settings.span }}">
      {%- for block in section.blocks -%}
        <figure class="lookbook__item" {{ block.shopify_attributes }}>
          <div class="lookbook__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: block.settings.caption | escape }}
            {%- endif -%}
            {%- if block.settings.tag != blank -%}<span class="lookbook__tag">{{ block.settings.tag }}</span>{%- endif -%}
          </div>
          <figcaption><span>{{ block.settings.caption }}</span></figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lookbook",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": ""
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": ""
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "unit": "",
      "default": 3
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image ratio",
      "default": "portrait",
      "options": [
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Inner spacing",
      "min": 50,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "span",
      "label": "Asymmetry",
      "default": "even",
      "options": [
        {
          "value": "even",
          "label": "Even"
        },
        {
          "value": "feature",
          "label": "Featured"
        },
        {
          "value": "mosaic",
          "label": "Mosaic"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo"
    }
  ],
  "max_blocks": 12
}
{% endschema %}
