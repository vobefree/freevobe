<section class="section ctl-wrap" data-reveal>
  <div class="container">
    <div class="section-head">
      <h2>{{ section.settings.title }}</h2>
      {%- if section.settings.subtitle != blank -%}<p>{{ section.settings.subtitle }}</p>{%- endif -%}
    </div>
    <div class="ctl variant-{{ section.settings.variant }} columns-{{ section.settings.columns }}">
      <div class="ctl__hero">
        {%- if section.settings.hero_image != blank -%}
          {{ section.settings.hero_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.title | escape }}
        {%- endif -%}
        <span>{{ section.settings.hero_title }}</span>
      </div>
      <div class="ctl__items">
        {%- for block in section.blocks -%}
          {%- if block.type == 'item' -%}
            <div class="ctl__item" {{ block.shopify_attributes }}>
              <span class="ctl__thumb">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: block.settings.name | escape }}
                {%- endif -%}
              </span>
              <span>{{ block.settings.name }}</span>
              <b>{{ block.settings.price }}</b>
            </div>
          {%- endif -%}
        {%- endfor -%}
        <div class="ctl__total">
          <b>{{ section.settings.total }}</b>
          <a class="btn" href="{{ routes.cart_url }}">{{ section.settings.cta_label }}</a>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Complete the look",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": ""
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": ""
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Main product",
      "default": ""
    },
    {
      "type": "text",
      "id": "total",
      "label": "Total price",
      "default": ""
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": ""
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Main product image"
    },
    {
      "type": "select",
      "id": "variant",
      "label": "Variant",
      "default": "bundle",
      "options": [
        {
          "value": "bundle",
          "label": "Bundle"
        },
        {
          "value": "cards",
          "label": "Cards"
        }
      ]
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "unit": "",
      "default": 4
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image ratio",
      "default": "portrait",
      "options": [
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Inner spacing",
      "min": 50,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "span",
      "label": "Asymmetry",
      "default": "even",
      "options": [
        {
          "value": "even",
          "label": "Even"
        },
        {
          "value": "feature",
          "label": "Featured"
        },
        {
          "value": "mosaic",
          "label": "Mosaic"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Product"
    }
  ],
  "max_blocks": 8
}
{% endschema %}
