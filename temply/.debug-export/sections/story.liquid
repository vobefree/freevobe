<section class="section story story--{{ section.settings.image_side }} columns-{{ section.settings.columns }} ratio-{{ section.settings.ratio }} gap-{{ section.settings.gap }} span-{{ section.settings.span }}" data-reveal>
  <div class="container story__inner">
    <div class="story__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: section.settings.title | escape }}
      {%- endif -%}
    </div>
    <div class="story__copy">
      <h2>{{ section.settings.title }}</h2>
      <p>{{ section.settings.text }}</p>
      <div class="story__steps">
        {%- for block in section.blocks -%}
          <div class="story__step" {{ block.shopify_attributes }}>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Storytelling",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": ""
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": ""
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "Image side",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "unit": "",
      "default": 2
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image ratio",
      "default": "portrait",
      "options": [
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Inner spacing",
      "min": 50,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "span",
      "label": "Asymmetry",
      "default": "even",
      "options": [
        {
          "value": "even",
          "label": "Even"
        },
        {
          "value": "feature",
          "label": "Featured"
        },
        {
          "value": "mosaic",
          "label": "Mosaic"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Chapter"
    }
  ],
  "max_blocks": 6
}
{% endschema %}
