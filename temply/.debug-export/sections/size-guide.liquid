<section class="section">
  <div class="container">
    <div class="section-head section-head--center">
      <h2>{{ section.settings.title }}</h2>
      {%- if section.settings.note != blank -%}<p>{{ section.settings.note }}</p>{%- endif -%}
    </div>
    <div class="size-table">
      <table>
        <thead>
          <tr>
            <th>{{ 'products.size' | t | default: 'Size' }}</th>
            <th>{{ section.settings.col_2 | default: 'Byst' }}</th>
            <th>{{ section.settings.col_3 | default: 'Längd' }}</th>
            <th>{{ section.settings.col_4 | default: 'Ärm' }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            {%- if block.type == 'row' -%}
              <tr {{ block.shopify_attributes }}>
                <td>{{ block.settings.size }}</td>
                <td>{{ block.settings.chest }}</td>
                <td>{{ block.settings.length }}</td>
                <td>{{ block.settings.sleeve }}</td>
              </tr>
            {%- endif -%}
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Size guide",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Storleksguide"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Note",
      "default": ""
    },
    {
      "type": "text",
      "id": "col_2",
      "label": "Column 2",
      "default": "Byst"
    },
    {
      "type": "text",
      "id": "col_3",
      "label": "Column 3",
      "default": "Längd"
    },
    {
      "type": "text",
      "id": "col_4",
      "label": "Column 4",
      "default": "Ärm"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "text",
          "id": "size",
          "label": "Size",
          "default": "M"
        },
        {
          "type": "text",
          "id": "chest",
          "label": "Column 2",
          "default": ""
        },
        {
          "type": "text",
          "id": "length",
          "label": "Column 3",
          "default": ""
        },
        {
          "type": "text",
          "id": "sleeve",
          "label": "Column 4",
          "default": ""
        }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Size guide"
    }
  ]
}
{% endschema %}
