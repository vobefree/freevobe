<section class="section compare-wrap" data-reveal>
  <div class="container">
    <div class="section-head section-head--center">
      <h2>{{ section.settings.title }}</h2>
      {%- if section.settings.subtitle != blank -%}<p>{{ section.settings.subtitle }}</p>{%- endif -%}
    </div>
    <div class="compare compare--{{ section.settings.variant }} columns-{{ section.settings.columns }}">
      <div class="compare__row compare__row--head">
        <span></span>
        {%- for block in section.blocks -%}
          {%- if block.type == 'plan' -%}
            <span class="compare__plan{% if block.settings.highlight %} is-highlight{% endif %}" {{ block.shopify_attributes }}>
              <b>{{ block.settings.title }}</b>
              <i>{{ block.settings.price }}</i>
            </span>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- for block in section.blocks -%}
        {%- if block.type == 'row' -%}
          <div class="compare__row" {{ block.shopify_attributes }}>
            <span class="compare__label">{{ block.settings.label }}</span>
            <span>{{ block.settings.value_1 }}</span>
            <span>{{ block.settings.value_2 }}</span>
            <span>{{ block.settings.value_3 }}</span>
            <span>{{ block.settings.value_4 }}</span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if section.settings.note != blank -%}<p class="hint">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Comparison",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": ""
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": ""
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Note",
      "default": ""
    },
    {
      "type": "select",
      "id": "variant",
      "label": "Variant",
      "default": "table",
      "options": [
        {
          "value": "table",
          "label": "Table"
        },
        {
          "value": "cards",
          "label": "Cards"
        }
      ]
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "unit": "",
      "default": 3
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image ratio",
      "default": "portrait",
      "options": [
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Inner spacing",
      "min": 50,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "span",
      "label": "Asymmetry",
      "default": "even",
      "options": [
        {
          "value": "even",
          "label": "Even"
        },
        {
          "value": "feature",
          "label": "Featured"
        },
        {
          "value": "mosaic",
          "label": "Mosaic"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "plan",
      "name": "Plan"
    },
    {
      "type": "row",
      "name": "Row"
    }
  ],
  "max_blocks": 12
}
{% endschema %}
