# Publik adress. Styr canonical, og:image, sitemap och robots.
# Lämnas tom i produktion (då används https://freevobe.dev).
# Sätts vid bygget för en förhandsgranskning:
# NEXT_PUBLIC_SITE_URL=https://site-xxxxxxxx.freebuff.page

# Sajten har inga annonser och ingen annonskonfiguration. Platsen där annonsen skulle ligga
# används av Gives Back (se src/components/sections/gives-back.tsx).

# Var nedladdningarna publiceras. Standardvärdet är samma repo som release-workflowen använder,
# så de behövs bara om releaserna flyttas (fork, annat konto eller egen domän).
# NEXT_PUBLIC_RELEASE_REPO=vobefree/freevobe
# NEXT_PUBLIC_RELEASE_TAG=v0.1.0
