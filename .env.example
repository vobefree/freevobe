# Lokal utveckling: filbaserad SQLite (libSQL). Skapas automatiskt.
DATABASE_URL=file:./data.db

# Produktion på Vercel: Turso/libSQL-databas (samma SQL fungerar som lokalt).
# Databas=libsql://xxx.turso.io
# TOKEN=<Turso auth token>
# DATABASE_URL=libsql://xxx.turso.io
# TURSO_AUTH_TOKEN=<Turso auth token>

# Nyckel för inloggningssessioner (använd en slumpad sträng på minst 32 tecken)
SESSION_SECRET=

# Första admin-kontot skapas vid första inloggningen
ADMIN_USERNAME=admin
ADMIN_PASSWORD=forshem

# Archil: beständig lagring på disk (server-side, aldrig i webbläsaren).
# API-nyckeln hämtas på https://console.archil.com/api-keys och börjar med "key-".
ARCHIL_API_KEY=
# Regionen nyckeln är skapad i (exec finns i aws-us-east-1, aws-us-west-2, aws-eu-west-1)
ARCHIL_REGION=aws-us-east-1
# Disken som används (dsk-…). Lämnas den tom skapar npm run check:archil en ny disk.
ARCHIL_DISK_ID=

# Systemets adress i fullformat (används av QR-koden på väggen, t.ex. https://klocka.forshem.se)
APP_URL=
