# Freevobe – kopiera till .env och justera vid behov.
# Allt är lokalt: inget lämnar maskinen om du inte aktiverar en molntjänst.

# Ollama
VIBEFORGE_OLLAMA_URL=http://localhost:11434
VIBEFORGE_DEFAULT_MODEL=deepseek-r1:8b

# Lokal agent-server (UI:t pratar bara med denna)
VIBEFORGE_PORT=4319
VIBEFORGE_HOST=127.0.0.1

# Var sessionsdatabas, minne och index sparas
VIBEFORGE_HOME=./.vibeforge

# Behörighetsläge: ask | auto-edit | auto-run | full-auto
VIBEFORGE_PERMISSION_MODE=ask

# Annonser i desktopappen: none | custom (adsense är avstängt som standard)
VIBEFORGE_ADS_PROVIDER=none

# Valfri molntjänst (avstängt som standard, kräver uttryckligt samtycke)
# VIBEFORGE_CLOUD_ENDPOINT=
# VIBEFORGE_CLOUD_API_KEY=
